The above array shows fixed appointments for an artist,
When there is an artist, I need the form to ensure that the times of selectable appointments are limited
so that we don't have conflicting appointments. Consider both the date and length.

Here is the date selection component:

import { useState } from "react";
import DatePicker from "react-datepicker";
import "react-datepicker/dist/react-datepicker.css";

// Optional: define a type for clarity
type AppointmentSlot = {
  date: Date | null;
  time: string;
};

interface Props {
  artist?: string
}

export default function DateAppointments({artist}: Props) {
  const [appointmentDates, setAppointmentDates] = useState<AppointmentSlot[]>([
    { date: null, time: "" },
    { date: null, time: "" },
    { date: null, time: "" },
  ]);

  console.log(artist)

  // Time slots from 12PM to 7PM in 30-minute increments
  const timeSlots = [
    "12:00 PM", "12:30 PM",
    "1:00 PM", "1:30 PM",
    "2:00 PM", "2:30 PM",
    "3:00 PM", "3:30 PM",
    "4:00 PM", "4:30 PM",
    "5:00 PM", "5:30 PM",
    "6:00 PM", "6:30 PM",
    "7:00 PM"
  ];

  // Only allow weekdays
  const isWeekday = (date: Date) => {
    const day = date.getDay();
    return day !== 0 && day !== 6;
  };

  // Update a date
  const handleDateChange = (date: Date | null, index: number) => {
    const newDates = [...appointmentDates];
    newDates[index].date = date;
    setAppointmentDates(newDates);
  };

  // Update a time
  const handleTimeChange = (
    e: React.ChangeEvent<HTMLSelectElement>,
    index: number
  ) => {
    const newDates = [...appointmentDates];
    newDates[index].time = e.target.value;
    setAppointmentDates(newDates);
  };

  return (
    <div className="mt-2">
      <div className="rounded border px-2 py-1 border-black shadow text-center w-[12rem] mb-3 text-sm font-semibold">
        <h3>Propose three dates</h3>
      </div>
      <div className="space-y-4">
        {appointmentDates.map((slot, index) => (
          <div key={index} className="flex flex-col sm:flex-row gap-2">
            {/* Date Picker */}
            <div className="flex-1">
              <label className="block text-sm font-medium mb-2">Date {index + 1}</label>
              <DatePicker
                selected={slot.date}
                onChange={(date) => handleDateChange(date, index)}
                filterDate={isWeekday}
                minDate={new Date()}
                className="w-full border shadow px-4 py-2 rounded bg-white"
                placeholderText="Select a date"
                dateFormat="MMMM d, yyyy"
              />
            </div>

            {/* Time Picker */}
            <div className="flex-1">
              <label className="block text-sm font-medium mb-2">Time {index + 1}</label>
              <select
                className="w-full border shadow px-4 py-2 rounded bg-white"
                value={slot.time}
                onChange={(e) => handleTimeChange(e, index)}
                disabled={!slot.date}
              >
                <option value="">{slot.date ? "Select time" : "Select date first"}</option>
                {timeSlots.map((time) => (
                  <option key={time} value={time}>
                    {time}
                  </option>
                ))}
              </select>
            </div>
          </div>
        ))}
      </div>

      <p className="text-sm text-gray-500 mt-4">
        Available Monday–Friday, 12PM–7PM (weekends automatically excluded)
      </p>
    </div>
  );
}
